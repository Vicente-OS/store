<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buyer Home</title>
    <style>
        body { font-family: sans-serif; padding: 2rem; background: #f4f4f4; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 2rem; }
        .card { background: white; padding: 1.5rem; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); display: flex; flex-direction: column; justify-content: space-between; }
        .btn { padding: 0.5rem 1rem; text-decoration: none; color: white; border-radius: 4px; border: none; cursor: pointer; }
        .btn-primary { background: #007bff; }
        .btn-danger { background: #dc3545; }
        .price { font-size: 1.25rem; font-weight: bold; color: #333; margin: 1rem 0; }
        .stock { color: #666; font-size: 0.9rem; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Welcome, Buyer <%= user.username %></h1>
        <a href="/logout" class="btn btn-danger">Logout</a>
    </div>

    <div class="grid">
        <% if (products.length === 0) { %>
            <p>No products available at the moment.</p>
        <% } %>
        <% products.forEach(product => { %>
            <div class="card">
                <div>
                    <h3><%= product.name %></h3>
                    <p><%= product.description %></p>
                    <div class="price">$<%= product.price %></div>
                    <div class="stock"><%= product.quantity %> items left</div>
                </div>
                <form action="/buyer/buy/<%= product.id %>" method="POST" style="margin-top: 1rem;">
                    <button type="submit" class="btn btn-primary" style="width: 100%;">Buy Now</button>
                </form>
            </div>
        <% }) %>
    </div>
</body>
</html>
