<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seller Dashboard</title>
    <style>
        body { font-family: sans-serif; padding: 2rem; background: #f4f4f4; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
        .widgets { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
        .widget { background: white; padding: 1.5rem; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        .hidden { display: none; }
        table { width: 100%; border-collapse: collapse; background: white; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        th, td { padding: 1rem; text-align: left; border-bottom: 1px solid #ddd; }
        .btn { padding: 0.5rem 1rem; text-decoration: none; color: white; border-radius: 4px; border: none; cursor: pointer; }
        .btn-primary { background: #007bff; }
        .btn-danger { background: #dc3545; }
        .btn-success { background: #28a745; }
        .btn-warning { background: #ffc107; color: black; }
        .controls { margin-bottom: 1rem; }
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center; }
        .modal-content { background: white; padding: 2rem; border-radius: 8px; width: 400px; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Welcome, Seller <%= user.username %></h1>
        <div>
            <a href="/logout" class="btn btn-danger">Logout</a>
        </div>
    </div>

    <div class="controls">
        <label><input type="checkbox" id="toggleSales" checked> Show Sales Widget</label>
        <label><input type="checkbox" id="toggleVisitors" checked> Show Visitors Widget</label>
        <a href="/seller/export" class="btn btn-success" style="float: right;">Export Report (CSV)</a>
        <button onclick="document.getElementById('addProductModal').style.display='flex'" class="btn btn-primary" style="float: right; margin-right: 1rem;">Add Product</button>
    </div>

    <div class="widgets">
        <div class="widget" id="salesWidget">
            <h3>Total Sales</h3>
            <p>$12,450 (Mock Data)</p>
        </div>
        <div class="widget" id="visitorsWidget">
            <h3>Recent Visitors</h3>
            <p>1,230 (Mock Data)</p>
        </div>
        <div class="widget">
            <h3>Total Products</h3>
            <p><%= products.length %></p>
        </div>
    </div>

    <h2>Inventory Management</h2>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% products.forEach(product => { %>
                <tr>
                    <td><%= product.name %></td>
                    <td>$<%= product.price %></td>
                    <td>
                        <form action="/seller/products/<%= product.id %>/update" method="POST" style="display:inline;">
                            <input type="hidden" name="action" value="update_stock">
                            <input type="number" name="quantity" value="<%= product.quantity %>" style="width: 60px;">
                            <button type="submit">Update</button>
                        </form>
                    </td>
                    <td>
                        <% if (product.is_published) { %>
                            <span style="color: green; font-weight: bold;">Published</span>
                        <% } else { %>
                            <span style="color: grey;">Draft</span>
                        <% } %>
                    </td>
                    <td>
                        <form action="/seller/products/<%= product.id %>/update" method="POST" style="display:inline;">
                            <% if (product.is_published) { %>
                                <input type="hidden" name="action" value="unpublish">
                                <button type="submit" class="btn btn-warning">Unpublish</button>
                            <% } else { %>
                                <input type="hidden" name="action" value="publish">
                                <button type="submit" class="btn btn-success">Publish</button>
                            <% } %>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <!-- Add Product Modal -->
    <div id="addProductModal" class="modal">
        <div class="modal-content">
            <h3>Add New Product</h3>
            <form action="/seller/products" method="POST">
                <input type="text" name="name" placeholder="Product Name" required style="width: 100%; margin-bottom: 1rem;">
                <input type="text" name="description" placeholder="Description" style="width: 100%; margin-bottom: 1rem;">
                <input type="number" step="0.01" name="price" placeholder="Price" required style="width: 100%; margin-bottom: 1rem;">
                <input type="number" name="quantity" placeholder="Quantity" required style="width: 100%; margin-bottom: 1rem;">
                <button type="submit" class="btn btn-primary">Add Product</button>
                <button type="button" class="btn btn-danger" onclick="document.getElementById('addProductModal').style.display='none'">Cancel</button>
            </form>
        </div>
    </div>

    <script>
        // Simple Dashboard Customization Logic
        const salesToggle = document.getElementById('toggleSales');
        const visitorsToggle = document.getElementById('toggleVisitors');
        const salesWidget = document.getElementById('salesWidget');
        const visitorsWidget = document.getElementById('visitorsWidget');

        // Load preferences
        if (localStorage.getItem('showSales') === 'false') {
            salesWidget.classList.add('hidden');
            salesToggle.checked = false;
        }
        if (localStorage.getItem('showVisitors') === 'false') {
            visitorsWidget.classList.add('hidden');
            visitorsToggle.checked = false;
        }

        // Save preferences
        salesToggle.addEventListener('change', (e) => {
            if (e.target.checked) salesWidget.classList.remove('hidden');
            else salesWidget.classList.add('hidden');
            localStorage.setItem('showSales', e.target.checked);
        });

        visitorsToggle.addEventListener('change', (e) => {
            if (e.target.checked) visitorsWidget.classList.remove('hidden');
            else visitorsWidget.classList.add('hidden');
            localStorage.setItem('showVisitors', e.target.checked);
        });
    </script>
</body>
</html>
